# Supabase — Car Pre-Vetting Tool
# Copy to .env.local and fill with values from your Supabase project settings.
# NEVER commit a real .env / .env.local. Only this example file is committed.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — DO NOT expose to the client. Used by server routes/migrations only.
# Never import this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
